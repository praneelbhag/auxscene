# SoundScene API keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Model/provider settings
ANTHROPIC_MODEL=claude-sonnet-5
ENABLE_WEB_SEARCH_GROUNDING=true
ELEVENLABS_MODEL_ID=eleven_text_to_sound_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_PROMPT_INFLUENCE=0.3
ELEVENLABS_MAX_CONCURRENT_REQUESTS=5
AUDIO_CACHE_ENABLED=true
AUDIO_CACHE_SIMILARITY_THRESHOLD=0.92

# Backend settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OUTPUT_DIR=./generated

# Audio generation and mixing
MAX_SOUND_DURATION_SECONDS=20
MIX_SAMPLE_RATE=44100
MIX_CHANNELS=2
AUDIO_CACHE_DIR=./generated/audio_cache

# Frontend settings
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_USE_MOCKS=false
