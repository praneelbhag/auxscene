# SoundScene API keys
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Model/provider settings
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_THINKING_LEVEL=medium
ENABLE_GOOGLE_SEARCH_GROUNDING=true
GEMINI_IMAGE_ASPECT_RATIO=16:9
ELEVENLABS_MODEL_ID=eleven_text_to_sound_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_PROMPT_INFLUENCE=0.3
ELEVENLABS_MAX_CONCURRENT_REQUESTS=5
AUDIO_CACHE_ENABLED=true
AUDIO_CACHE_SIMILARITY_THRESHOLD=0.92
AUDIO_REVIEW_ENABLED=true
AUDIO_REVIEW_MODEL=gemini-2.5-flash
AUDIO_REVIEW_AUTO_RETRY=true
AUDIO_REVIEW_MIN_SCORE=0.72

# Backend settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OUTPUT_DIR=./generated

# Audio generation and mixing
MAX_SOUND_DURATION_SECONDS=20
MIX_SAMPLE_RATE=44100
MIX_CHANNELS=2
AUDIO_CACHE_DIR=./generated/audio_cache

# Frontend settings
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_USE_MOCKS=false
